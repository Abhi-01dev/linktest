# ===================================================================
# LinkTest Java Backend Configuration (.env.example)
# Copy to .env or export as environment variables before starting.
# NEVER commit production credentials or secrets to source control.
# ===================================================================

# Server Port (Use 8081 for drop-in Express replacement, or 8082 for side-by-side testing)
PORT=8082
SPRING_PROFILES_ACTIVE=local

# PostgreSQL Database (Neon Cloud / Local)
# JDBC format: jdbc:postgresql://<host>:<port>/<database>?sslmode=require
DATABASE_URL=jdbc:postgresql://localhost:5432/linktest
DB_USERNAME=postgres
DB_PASSWORD=your_database_password_here

# JWT Security
# Must be at least 256 bits (32 characters) for HMAC-SHA256
JWT_SECRET=your_secure_256_bit_jwt_secret_key_here
JWT_EXPIRATION_MS=604800000

# Google OAuth 2.0 / OpenID Connect Client ID
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Frontend Application Origin(s) for CORS (comma-separated)
FRONTEND_URL=http://localhost:5173,http://localhost:5174

# Ollama Local AI Integration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# Gmail SMTP Configuration for Email Notifications
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_APP_PASSWORD=your_gmail_app_password_here
SMTP_FROM_NAME=LinkTest Learning Platform
SMTP_FROM_EMAIL=your_email@gmail.com

# LiveKit WebRTC Cloud Video Classes
LIVEKIT_URL=wss://linktest-live-lectures-25m7dpyi.livekit.cloud
LIVEKIT_API_KEY=APIdiwcZhRuUifQ
LIVEKIT_API_SECRET=your_livekit_api_secret_here
