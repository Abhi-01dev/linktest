# LinkTest Frontend Environment Variables Configuration Template
# Set to your backend API URL. For production, point to your deployed backend (e.g. https://linktest-api.onrender.com)
VITE_API_URL=http://localhost:8081
VITE_API_BASE_URL=http://localhost:8081/api

# Google Identity Services Client ID (Public Web OAuth Client ID from Google Cloud Console)
# NEVER put GOOGLE_CLIENT_SECRET here!
VITE_GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com

