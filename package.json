{
  "name": "linktest-platform",
  "version": "1.0.0",
  "description": "LinkTest — AI-Powered Learning, Practice, Assessment, and Progress-Tracking Platform",
  "private": true,
  "scripts": {
    "dev": "concurrently -n \"backend,frontend\" -c \"blue,green\" \"npm run dev:backend\" \"npm run dev:frontend\"",
    "dev:backend": "npm --prefix backend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
    "start:backend": "npm --prefix backend start",
    "build": "npm --prefix frontend run build",
    "test": "npm --prefix backend test && node --test tests/**/*.test.js",
    "test:backend": "npm --prefix backend test",
    "test:root": "node --test tests/**/*.test.js",
    "test:e2e": "powershell -ExecutionPolicy Bypass -File ./test-all-e2e.ps1",
    "install:all": "npm install && npm --prefix backend install && npm --prefix frontend install"
  },
  "devDependencies": {
    "concurrently": "^8.2.2"
  },
  "keywords": [
    "linktest",
    "edtech",
    "learning-platform",
    "ai-tutor",
    "ollama",
    "assessment"
  ],
  "author": "LinkTest Engineering Team",
  "license": "ISC"
}
