# ==============================================================================
# LinkTest Backend Environment Variables Configuration Template
# ==============================================================================

# Server Runtime
PORT=8081
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. Database Connection (PostgreSQL)
# ------------------------------------------------------------------------------
# Local PostgreSQL:
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/linktest
# Managed Cloud PostgreSQL (Neon / Render / Supabase):
# DATABASE_URL=postgresql://neondb_owner:YOUR_KEY@ep-cool-base-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# ------------------------------------------------------------------------------
# 2. Security & JWT
# ------------------------------------------------------------------------------
JWT_SECRET=linktest_jwt_super_secret_key_change_in_production_2026
FRONTEND_URL=http://localhost:5173

# ------------------------------------------------------------------------------
# 3. Gmail SMTP Email Verification & Invitations
# ------------------------------------------------------------------------------
# NOTE: Use a Google App Password from https://myaccount.google.com/apppasswords
# Never use your personal Google account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_APP_PASSWORD=
SMTP_FROM_NAME=LinkTest LMS
SMTP_FROM_EMAIL=no-reply@linktest.io

# ------------------------------------------------------------------------------
# 4. Local AI Tutor (Ollama)
# ------------------------------------------------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen3:8b

# ------------------------------------------------------------------------------
# 5. Cloud AI Provider Fallback (Optional - for Cloud Deployments)
# ------------------------------------------------------------------------------
# Used when deployed online and localhost:11434 is unreachable
CLOUD_AI_PROVIDER=groq
CLOUD_AI_API_KEY=
CLOUD_AI_BASE_URL=https://api.groq.com/openai/v1
CLOUD_AI_MODEL=llama-3.1-8b-instant

# ------------------------------------------------------------------------------
# 6. File Storage (Local disk or Supabase Storage)
# ------------------------------------------------------------------------------
STORAGE_PROVIDER=local
MAX_FILE_SIZE_MB=15
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_STORAGE_BUCKET=linktest-materials

# ------------------------------------------------------------------------------
# 7. Live Video Classes (LiveKit WebRTC)
# ------------------------------------------------------------------------------
# Get credentials at https://cloud.livekit.io
LIVEKIT_SERVER_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# ------------------------------------------------------------------------------
# 8. Google OAuth 2.0 / OpenID Connect (Google Sign-In)
# ------------------------------------------------------------------------------
# Obtain from Google Cloud Console -> APIs & Services -> Credentials
# Web Application Client ID and Secret:
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_CALLBACK_URL=http://localhost:8081/api/auth/google/callback

# ------------------------------------------------------------------------------
# 9. Production Administrator Account Provisioning
# ------------------------------------------------------------------------------
ADMIN_EMAIL=your-admin-email@example.com
ADMIN_PASSWORD=your-secure-password
ADMIN_NAME=Platform Administrator

# ------------------------------------------------------------------------------
# 10. Isolated Coding Sandbox (Issue #23: Docker Container Runner)
# ------------------------------------------------------------------------------
# Controlled execution container runtime images
SANDBOX_NODE_IMAGE=node:20-alpine
SANDBOX_PYTHON_IMAGE=python:3.11-alpine
# Container resource quotas
SANDBOX_CPU_LIMIT=0.5
SANDBOX_DEFAULT_MEMORY_MB=128
SANDBOX_MAX_MEMORY_MB=512
SANDBOX_PIDS_LIMIT=64
SANDBOX_MAX_OUTPUT_BYTES=65536
SANDBOX_MAX_CODE_CHARS=65536


